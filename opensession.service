# ============================================================================
# TEMPLATE — installed and rewritten by `opensession service install`
# (renderUnit), which stamps in your user, paths, and PATH. Do NOT hand-copy
# this file into /etc/systemd/system; a raw copy ships someone else's paths.
# ============================================================================
[Unit]
Description=Open Session - agent session dashboard
# Protocol peers are enabled independently. Do not Wants=/Requires= them here:
# socket activation during a rollout must not restart a peer that the deploy
# controller intentionally stopped. The child generation barrier fails closed.
Wants=opensession.socket opensession-ingress.service
After=network.target opensession-ingress.service opensession-session-kernel.service opensession-executor.service

[Service]
# Keep latency-sensitive HTTP, WebSocket, and orchestration work ahead of
# repository builds when the host is saturated.
Slice=opensession-control.slice
# PATH is passed straight through to engine subprocesses (engineEnv()/
# host-client), so any toolchains your code sessions need must be on it —
# interactive shells get it from the login profile; the service must carry
# it explicitly.
Environment="PATH=/home/ubuntu/.cargo/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Type=simple
User=ubuntu
RuntimeDirectory=opensession-gateway
RuntimeDirectoryMode=0700
WorkingDirectory=/home/ubuntu/projects/opensession
EnvironmentFile=/home/ubuntu/.opensession.env
# EXECUTOR_CREDENTIAL: rendered installs replace this marker. Keeping the
# source template optional lets the previous deploy script introduce this
# release without failing before it knows how to install the credential.
# SESSION_KERNEL_CREDENTIAL
Environment="NODE_ENV=production"
Environment="OPENSESSION_EXTERNAL_INGRESS=1"
# Do not use `bun --hot` here. A failed reload on Bun 1.3.14 can permanently
# stop every timer while HTTP keeps serving, leaving all sessions apparently
# running but unable to progress. Backend changes use a deliberate graceful
# restart; detached engine turns survive and the run journal reattaches them.
# The app's own frontend watcher still rebuilds frontend edits live. A stable
# supervisor keeps one active child, preloads an inert candidate, observes the
# old child exit, and only then releases the candidate's activation barrier.
ExecStart=/home/ubuntu/.bun/bin/bun run packages/core/opensession-server/src/server/gateway-supervisor.ts
Restart=always
# 1s, not 5s: this pause is pure downtime on every restart (deliberate or
# crash), and Caddy's lb_try_duration parks requests meanwhile — a crash loop
# is still rate-limited by the unit's start-rate limiting.
RestartSec=1
# Give graceful shutdown time to stop agent intake and drain in-flight runs
# (SHUTDOWN_DRAIN_MS defaults to 10s) before systemd escalates to SIGKILL.
# TimeoutStopSec also covers bounded agent shutdown hooks, so it intentionally
# stays well above the run-drain bound. The journal resumes anything still
# mid-turn; a shorter drain trades a little redo for a faster restart, not loss.
TimeoutStopSec=80
# SIGTERM the bun parent ONLY — not the whole cgroup. The default
# (KillMode=control-group) SIGTERMs every child too, so on restart the Claude
# subprocesses die (exit 143) the instant shutdown begins — before bun's graceful
# drain can run, and before the run journal can do its job. Worse, a loop that
# catches that kill (e.g. github auto-fix) marks itself "done" and defeats its own
# restart recovery. With `mixed`, only bun gets SIGTERM; it drains in-flight runs
# (children keep working) and exits, then systemd SIGKILLs any leftovers after
# TimeoutStopSec. This is what makes the graceful-drain + journal-resume design
# actually take effect.
KillMode=mixed
# Agent runs are driven by untrusted text (customer tickets); none of them
# should be able to mint EC2 instance-role credentials from the metadata
# endpoint. eBPF egress filter — covers every child the service spawns.
# Remove if a session ever legitimately needs the role.
IPAddressDeny=169.254.169.254/32

[Install]
WantedBy=multi-user.target
