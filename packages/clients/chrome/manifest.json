{
  "manifest_version": 3,
  "name": "OS",
  "version": "0.1.0",
  "description": "Capture page context and start Open Session agent sessions.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "OS"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "sidePanel"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
