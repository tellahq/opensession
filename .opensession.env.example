# Open Session environment — example.
# Copy to ~/.opensession.env and chmod 0600 it. The systemd unit loads it via
# EnvironmentFile=; for manual `bun run opensession.ts` runs, Bun auto-loads a
# .env in the checkout instead.
#
# Everything here is optional: the server boots without any of it, and each
# integration stays off until its vars (and its ENABLE_* flag) are set.
# Full inventory: docs/setup/install.md and docs/instance-configuration.md.

# --- Core server ---
# HOST=127.0.0.1                 # bind address; a Tailscale IP shares it with your team
# PORT=3850                      # private app server (UI + API)
# OPENSESSION_UI_BASE=http://127.0.0.1:3850   # private app address used in posted links
# OPENSESSION_INGRESS_BASE=https://ingress.example.com # public webhooks, Sandbox callbacks and workload identity

# --- Engines and models (docs/setup/engines.md) ---
# OPENSESSION_MODEL=claude-fable-5-1            # default model
# OPENSESSION_FALLBACK_MODEL=none             # global fallback model; `none` disables
# OPENSESSION_HAIKU_FALLBACK_MODEL=gpt-5.6-luna # cross-provider fallback for Haiku; `none` disables

# --- Integrations (flags default OFF; only the literal string "true" enables) ---
# Slack (docs/setup/slack.md)
# ENABLE_SLACK_AGENT=true
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...

# GitHub App (docs/setup/github.md). Configure these here OR in Settings;
# OPENSESSION_GITHUB_APP_KEY is a PEM file path, not the key contents.
# ENABLE_GITHUB_AGENT=true
# OPENSESSION_GITHUB_CLIENT_ID=Iv...
# OPENSESSION_GITHUB_CLIENT_SECRET=...
# OPENSESSION_GITHUB_APP_SLUG=open-session-example
# OPENSESSION_GITHUB_APP_KEY=/srv/opensession/secrets/github-app.pem
# GITHUB_WEBHOOK_SECRET=...

# Linear (docs/setup/linear.md)
# ENABLE_LINEAR_AGENT=true
# LINEAR_API_KEY=lin_api_...
# LINEAR_WEBHOOK_SECRET=...

# Plain (docs/setup/plain.md)
# ENABLE_PLAIN_AGENT=true
# PLAIN_API_KEY=...
# PLAIN_WEBHOOK_SECRET=...

# The rest — Stripe, Grafana, voice/transcription, sandboxes, previews,
# resource limits — are covered in docs/setup/*.md and
# docs/instance-configuration.md.
