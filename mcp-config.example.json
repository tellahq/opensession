{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "braintrust": {
      "type": "http",
      "url": "https://api.braintrust.dev/mcp",
      "headers": {
        "Authorization": "Bearer <your-braintrust-api-key>"
      }
    },
    "fathom": {
      "_comment": "First-party read-only Fathom server. Store real values only in your gitignored mcp-config.json.",
      "command": "opensession",
      "args": ["fathom-mcp"],
      "env": {
        "FATHOM_API_TOKEN": "<site-specific-read-only-token>",
        "FATHOM_SITE_ID": "<site-id>"
      },
      "allowedUsers": ["Grant"]
    },
    "my-custom-server": {
      "_comment": "Example: your own stdio MCP server. `command` (+ optional `args`) is spawned per run; pass its credentials via the per-server `env` block.",
      "command": "bun",
      "args": ["run", "/path/to/your-mcp-server/src/index.ts"],
      "env": {
        "MY_SERVER_API_KEY": "<your-api-key>"
      }
    },
    "tinybird": {
      "type": "http",
      "url": "https://mcp.tinybird.co?token=<your-tinybird-token>"
    },
    "circle": {
      "type": "http",
      "url": "https://app.circle.so/api/mcp"
    },
    "dub": {
      "type": "http",
      "url": "https://mcp.dub.sh/mcp/dub-links",
      "headers": {
        "Mcp-Dub-Token": "<your-dub-api-key>"
      }
    }
  }
}
