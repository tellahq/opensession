# Shallow source mirrors that skills tell agents to clone for API lookups
# (for example .agent-sources/effect at the pinned effect tag).
.agent-sources/
.css-shots/
.css-ab/

# simple-mode harness work dir
test/simple-mode/.work/
test/simple-mode/.work-run.log

# Compiled single-executable build (scripts/build-compile.ts)
/opensession
