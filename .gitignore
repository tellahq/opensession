# Local environment and credential files. Keep sanitized templates tracked.
*.env
*.env.*
!*.env.example
!*.env.*.example
.envrc
.envrc.*
*.key
*.pem
*.p12
*.pfx
*.pkcs12
*.ppk
*.cer
*.crt
*.csr
*.der
*.jks
*.keystore

# Local MCP config contains live API tokens — use mcp-config.example.json as a template
mcp-config.json

# Instance-local operator instructions (appended to every engine run by
# readLocalInstructions in src/server/run-policy.ts) — never tracked
AGENTS.local.md
CLAUDE.local.md

# Slack data caches
.users_cache.json
.channels_cache.json
.channels_cache_v2.json
mcp-config.json.bak

# Codex CLI platform binary (223MB — exceeds GitHub's file limit; restored by `bun install`)
node_modules/@openai/codex-linux-x64/
node_modules/.bin/codex
.frontend-dist/
.website-dist/
.website-dist-stage/
packages/clients/website/.demo-tailwind.css
packages/clients/website/.next/
packages/clients/website/tsconfig.tsbuildinfo
node_modules
__pycache__/
*.pyc

# Session captures, reviews, previews, worktrees, and generated deliverables.
# The OS1 icon source and its build scripts are intentional tracked examples.
.artifacts/
/artifacts/verification/
.capture/
.captures/
.hero-check/
.opensession-review/
.review-fix/
.session-preview/
.shots/
.shots-tmp/
.tmp*/
.worktrees/
output/*
!output/os1-icons/
!output/os1-icons/**
output/**/previews/
output/**/*.icns
output/**/*.iconset/
output/os1-icons/icon-512-padded.png

# Downloaded BusyBox binary and corresponding source for the microvm rootfs
# (re-fetched and checksum-verified by build-rootfs.sh when absent).
deploy/sandbox/microvm/.cache-busybox
deploy/sandbox/microvm/.cache-busybox-source.tar.bz2

# Dev Portal state + Portal port seeds (.agents/start.sh boots a dev instance
# with OPENSESSION_STATE_DIR=$PWD/.dev-state; Portals write .ports.conf and
# .ports/ into the session's working dir)
.dev-state/
.ports.conf
.ports/

# macOS Finder metadata
.DS_Store

# Vendored third-party agent skills are instance-local. Open Session's own
# generic skills are tracked below, and every run loads this directory
