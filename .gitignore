*.key
*.crt

# Local MCP config contains live API tokens — use mcp-config.example.json as a template
mcp-config.json

# Instance-local operator instructions (appended to every engine run by
# readLocalInstructions in src/server/opencode-runner.ts) — never tracked
AGENTS.local.md
CLAUDE.local.md

# Slack data caches
.users_cache.json
.channels_cache.json
.channels_cache_v2.json
mcp-config.json.bak

# Codex CLI platform binary (223MB — exceeds GitHub's file limit; restored by `bun install`)
node_modules/@openai/codex-linux-x64/
node_modules/.bin/codex
.frontend-dist/
.website-dist/
.website-dist-stage/
website/.demo-tailwind.css
node_modules
__pycache__/
*.pyc

# output/ holds session deliverables (e.g. the OS1 app icon under
# output/os1-icons). Sources are tracked — only rendered artifacts are
# ignored (rebuild via generate.ts + build-fallbacks.sh + ictool).
output/**/previews/
output/**/*.icns
output/**/*.iconset/
output/os1-icons/icon-512-padded.png

# Downloaded static busybox for the microvm rootfs (re-fetched by
# deploy/sandbox/microvm/build-rootfs.sh when absent)
deploy/sandbox/microvm/.cache-busybox

# Self-preview dev-instance state + preview-flow port seeds (.agents/start.sh
# boots a dev instance with OPENSESSION_STATE_DIR=$PWD/.dev-state; the Preview
# flow writes .ports.conf/.ports/ into the session's working dir)
.dev-state/
.ports.conf
.ports/

# macOS Finder metadata
.DS_Store

# Vendored third-party agent skills are instance-local. Open Session's own
# generic skills are tracked below and linked into OpenCode's global skill dir
# by install.sh.
.agents/skills/
!.agents/skills/
.agents/skills/*
!.agents/skills/simplify/
!.agents/skills/simplify/**
!.agents/skills/pr-autofix/
!.agents/skills/pr-autofix/**
!.agents/skills/audit-codebase/
!.agents/skills/audit-codebase/**
.claude/skills
skills-lock.json
.css-shots/
.css-ab/

# simple-mode harness work dir
test/simple-mode/.work/
test/simple-mode/.work-run.log

# Compiled single-executable build (scripts/build-compile.ts)
/opensession
