{
  "name": "opensession",
  "version": "0.1.0",
  "private": true,
  "description": "Open Session — self-hosted agent session dashboard: run, watch, and steer AI coding sessions from the web UI, Slack, and native clients",
  "homepage": "https://opensession.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tellahq/opensession.git"
  },
  "bin": {
    "opensession": "scripts/cli.ts"
  },
  "workspaces": [
    "packages/clients/website",
    "packages/core/opensession-server",
    "packages/core/protocol",
    "packages/core/subscription-gateway",
    "packages/integrations/apple-mobile"
  ],
  "scripts": {
    "app:dev": "bun scripts/app-dev.ts",
    "bench:memory": "bun scripts/memory-bench.ts",
    "check": "bun run format:check && bun run typecheck && bun run lint && scripts/test-unit-isolated.sh && bun run test:snapshots",
    "dev": "bun --hot packages/core/opensession-server/opensession.ts",
    "format": "oxfmt",
    "format:check": "bun scripts/check-format.ts",
    "opensession": "bun scripts/cli.ts",
    "setup": "bun scripts/cli.ts onboard",
    "start": "bun packages/core/opensession-server/opensession.ts",
    "test": "bun test packages/core/opensession-server/src scripts",
    "test:snapshots": "OPENSESSION_EXECUTOR=0 OPENSESSION_TEST_IN_PROCESS_RUNS=1 OPENSESSION_SNAPSHOT_STRICT=1 bun test packages/core/opensession-server/src/server/zz-snapshot-runs.test.ts",
    "test:transcript-scroll": "bun packages/core/opensession-server/src/frontend/tools/transcript-scroll-regression.ts",
    "lint": "bun run check:compiler && oxlint packages/core/opensession-server/src/frontend",
    "check:compiler": "bun scripts/check-react-compiler.ts",
    "typecheck": "tsc --noEmit",
    "website:build": "bun --cwd packages/clients/website build",
    "website:dev": "bun --cwd packages/clients/website dev"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "@aws-sdk/client-lambda-microvms": "3.1090.0",
    "@base-ui/react": "^1.6.0",
    "@daytonaio/sdk": "0.201.0",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/rust": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pierre/diffs": "1.3.2",
    "@pierre/trees": "^1.0.0-beta.4",
    "@rynfar/meridian": "1.66.0",
    "@rynfar/meridian-source": "github:rynfar/meridian#00a2f82d50df0921aa3410f216d7e0a8908b8fc1",
    "@shadcn/react": "^0.3.0",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@team-plain/typescript-sdk": "^5.12.1",
    "@tellahq/opensession-protocol": "workspace:*",
    "@tellahq/opensession-server": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "e2b": "2.32.0",
    "emoji-datasource": "^16.0.0",
    "ghostty-web": "^0.4.0",
    "marked": "^15.0.0",
    "mermaid": "^11.16.1",
    "modal": "0.9.0",
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.4",
    "shiki": "3.23.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "agentation": "^3.0.2",
    "oxc-transform-react": "^0.147.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.2"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@base-ui/react@1.6.0": "patches/@base-ui%2Freact@1.6.0.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch"
  }
}
