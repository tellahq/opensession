{
  "name": "opensession",
  "version": "0.1.0",
  "private": true,
  "description": "Open Session — self-hosted agent session dashboard: run, watch, and steer AI coding sessions from the web UI, Slack, and native clients",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tellahq/opensession.git"
  },
  "homepage": "https://opensession.com",
  "opensession": {
    "opencodeVersion": "1.18.18"
  },
  "workspaces": ["packages/*"],
  "bin": {
    "opensession": "scripts/cli.ts"
  },
  "scripts": {
    "app:dev": "bun scripts/app-dev.ts",
    "bench:memory": "bun scripts/memory-bench.ts",
    "dev": "bun --hot opensession.ts",
    "opensession": "bun scripts/cli.ts",
    "setup": "bun scripts/cli.ts onboard",
    "start": "bun opensession.ts",
    "test": "bun test src scripts",
    "test:snapshots": "OPENSESSION_SNAPSHOT_STRICT=1 bun test src/server/zz-snapshot-runs.test.ts",
    "typecheck": "tsc --noEmit",
    "website:build": "bun scripts/build-website.ts",
    "website:dev": "bun --hot scripts/website-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.104",
    "@aws-sdk/client-lambda-microvms": "3.1090.0",
    "@base-ui/react": "^1.6.0",
    "@daytonaio/sdk": "0.194.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/rust": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "1.18.18",
    "@pierre/diffs": "1.3.2",
    "@pierre/trees": "^1.0.0-beta.4",
    "@rynfar/meridian": "1.51.0",
    "@rynfar/meridian-plugin-opencode-scrub": "0.2.0",
    "@shadcn/react": "^0.3.0",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@team-plain/typescript-sdk": "^5.12.1",
    "@tellahq/opensession-protocol": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "e2b": "2.32.0",
    "emoji-datasource": "^16.0.0",
    "ghostty-web": "^0.4.0",
    "marked": "^15.0.0",
    "mermaid": "^11.16.1",
    "modal": "0.9.0",
    "motion": "^12.42.2",
    "opencode-with-claude": "1.6.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.34.5",
    "shiki": "3.23.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "agentation": "^3.0.2",
    "tailwindcss": "^4.3.2"
  },
  "patchedDependencies": {
    "@base-ui/react@1.6.0": "patches/@base-ui%2Freact@1.6.0.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
    "@rynfar/meridian@1.51.0": "patches/@rynfar%2Fmeridian@1.51.0.patch"
  }
}
